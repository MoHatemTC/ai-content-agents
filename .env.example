# ---------------------------------------------------------------------------
# Sensei-AI runtime configuration (Vite). Copy to `.env.local` and fill in.
#
# NEVER commit real Supabase credentials. The anon key is publishable (safe to
# commit), but the backend JWT secret must stay in the backend .env only.
# ---------------------------------------------------------------------------

# FastAPI backend base URL. Must NOT be "/api" or the app silently stays in
# mock mode (isMockMode() == ENABLE_MOCK || API_BASE_URL === "/api").
VITE_API_BASE_URL=http://localhost:8000

# Supabase project URL + publishable anon key (browser-safe).
VITE_SUPABASE_URL=https://<your-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# REAL mode (backend + Supabase). Set to true to run the app fully offline
# against mock fixtures. Safety: if VITE_API_BASE_URL defaults to "/api" the
# app is mock even when this is false.
VITE_ENABLE_MOCK=false

# Default AI provider id shown in the model selector.
VITE_DEFAULT_MODEL=mock