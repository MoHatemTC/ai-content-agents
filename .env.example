LITELLM_BASE_URL=https://learner-os.sprints.ai/litellm
LITELLM_API_KEY= # Your LiteLLM API key here — never commit the real key
DEFAULT_MODEL=kimi-k2.5

# Ask the gateway which models it serves:
#   client.models.list()  ->  kimi-k2.5, kimi-k2.6, fw-kimi-k2.6, whisper

# Where the platform tables (agent_runs, generated_outputs, reviews,
# system_events) live. Shares the ingestion database by default.
PLATFORM_DB_PATH=ingestion.db

# ==========================================================
# There is no MOCK_MODE. Agents call the real gateway; a
# missing LITELLM_API_KEY / LITELLM_BASE_URL is an error at
# construction, not a silent fallback to canned output.
#
# Tests inject a fake client instead:
#
#     MentorAgent(client=FakeLLMClient(reply))
#
# The old flag swapped real output for fake output at
# runtime, and the app served placeholder cards to users
# for weeks because a UI forced it on. A test double cannot
# do that, because nothing in production constructs one.
# ==========================================================

# Which embedder indexes and queries documents.
#   onnx    -> Chroma's default model. Semantic; one-time ~80 MB download.
#   hashing -> Deterministic offline embedder. No download, not semantic.
#
# The two are not interchangeable on an existing index: their vectors are
# not comparable, so switching means re-ingesting. Opening an index built
# by the other one is refused with an error saying so.
RETRIEVAL_EMBEDDER=onnx

# Scanned/image-only PDFs carry no text layer, so ingestion rejects them as
# empty. With OCR on they are rendered page by page and read with Tesseract.
# Needs the Tesseract *binary*, not just the pytesseract package:
#   Windows https://github.com/UB-Mannheim/tesseract/wiki (or: choco install tesseract)
#   macOS   brew install tesseract
#   Linux   apt-get install tesseract-ocr
# Off by default because it cannot be assumed present, and it is slow
# (seconds per page), so it only ever runs as a fallback.
ENABLE_OCR=false

# Only needed if the binary is installed somewhere non-standard and off PATH.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Tesseract reads printed characters; it cannot read handwriting, and on a
# handwritten page it returns nonsense rather than failing. When OCR output does
# not read as language, a vision model can transcribe the pages instead.
#
# Off by default for two reasons. It costs money per page against the LiteLLM
# gateway. And what it produces is *model output*, not extracted text - such
# documents are stored with source_type "file-vision-ocr" and should be treated
# as pending human verification, not as source evidence. See
# docs/ocr-and-content-quality.md.
ENABLE_VISION_OCR=false

# A small vision model is the default on purpose: on the page this was built for
# it transcribed more of the working than a larger one. The gateway rejects a
# request whose requested max_tokens exceeds the remaining credit, so the cap is
# always sent explicitly.
VISION_OCR_MODEL=qwen/qwen3-vl-8b-instruct
VISION_OCR_MAX_TOKENS=1500

# FastAPI layer (backend/). Comma-separated allowed origins. Unset defaults to
# "*" (permissive, development only); set explicit origins for anything shared.
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Session lifetime for the opaque bearer tokens issued by POST /auth/login and
# rotated by POST /auth/refresh. Access tokens expire after the short window;
# refresh tokens live longer and swap for a fresh pair on refresh.
# AUTH_ACCESS_TTL_SECONDS=3600
# AUTH_REFRESH_TTL_SECONDS=86400

# Maximum accepted upload size for POST /upload in bytes. Defaults to 50MB -
# aligned with the Supabase free-tier per-file limit the future frontend
# storage targets; a larger file returns 413 payload_too_large.
# MAX_UPLOAD_BYTES=52428800

# Where the Chroma retrieval index persists. Embedding is ~97% of ingest cost -
# about 115s for a 1,598-page textbook - and its rate cannot be tuned, so
# without this the index lives in memory and every restart re-embeds from
# scratch. Measured: re-opening a persisted index takes 0.0s.
#
# Leave unset to keep the index in memory; tests and CI always do.
# The directory is disposable - delete it and re-ingest to rebuild.
CHROMA_DIR=.chroma

# ============================================================================
# Supabase (single auth provider) — REQUIRED for authenticated endpoints
# ----------------------------------------------------------------------------
# The Sensei-AI frontend authenticates with Supabase Auth and sends the access
# token to this API (Authorization: Bearer <token>).
#
# Verification strategy:
#   * Set SUPABASE_JWT_SECRET for fast local verification of the access token
#     (signature, expiry, iss = <SUPABASE_URL>/auth/v1, aud = "authenticated").
#     The JWT secret is in the Supabase dashboard: Project Settings -> API ->
#     JWT Secret. NEVER commit the real value.
#   * If the secret is left empty but SUPABASE_URL + SUPABASE_ANON_KEY are set,
#     the backend verifies through GoTrue (GET <SUPABASE_URL>/auth/v1/user),
#     which validates the token server-side.
# Leave all empty to run Health (/) and the dev scaffold login only; protected
# endpoints then return 401 "Supabase is not configured".
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_JWT_SECRET=
# SUPABASE_ANON_KEY=eyJhbGciOi...
# ==========================================================
# Opt-in test lanes. Both are OFF by default and neither
# runs in CI, which has no credentials.
#
# RUN_LIVE_TESTS=true
#   Runs the tests that call the real gateway.
#
# RUN_DEEPEVAL_TESTS=true
#   Runs the LLM-judged quality checks. Also needs
#   `pip install -e ".[eval]"`. Scores are non-deterministic
#   and every run costs API calls, which is why they are
#   kept out of the default suite.
#
# DEEPEVAL_JUDGE_MODEL
#   Scoring model for those checks. Defaults to
#   DEFAULT_MODEL; set it to something stronger to avoid
#   judging a model's output with itself.
# ==========================================================

# Largest file the ingestion lane will accept, in bytes. Defaults to 35 MB.
# Embedding is ~97% of ingest cost and its rate cannot be tuned, so file size
# is the only place that wait is bounded. Raise it only on a machine that can
# afford the time. Keep .streamlit/config.toml's maxUploadSize in step - the
# widget refuses before the bytes are sent, the loader refuses whatever the
# other entry points hand it.
# MAX_UPLOAD_BYTES=36700160
