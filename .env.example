LITELLM_BASE_URL=https://learner-os.sprints.ai/litellm
LITELLM_API_KEY= # Your LiteLLM API key here — never commit the real key
DEFAULT_MODEL=kimi-k2.5

# Ask the gateway which models it serves:
#   client.models.list()  ->  kimi-k2.5, kimi-k2.6, fw-kimi-k2.6, whisper

# Where the platform tables (agent_runs, generated_outputs, reviews,
# system_events) live. Shares the ingestion database by default.
PLATFORM_DB_PATH=ingestion.db

# ==========================================================
# MOCK_MODE controls the agent ONLY when you create it as:
#
#     agent = MentorAgent()
#
# It has NO effect if you explicitly pass:
#
#     MentorAgent(mock_mode=True)
#     MentorAgent(mock_mode=False)
#
# true  -> Use the hardcoded mock response.
# false -> Call the real LiteLLM API.
#
# Keep the example default at "true" so a fresh setup
# (copy .env.example -> .env) never makes live API calls
# by accident; set it to "false" only when you have a key.
# ==========================================================

MOCK_MODE=true

# Scanned/image-only PDFs carry no text layer, so ingestion rejects them as
# empty. With OCR on they are rendered page by page and read with Tesseract.
# Needs the Tesseract *binary*, not just the pytesseract package:
#   Windows https://github.com/UB-Mannheim/tesseract/wiki (or: choco install tesseract)
#   macOS   brew install tesseract
#   Linux   apt-get install tesseract-ocr
# Off by default because it cannot be assumed present, and it is slow
# (seconds per page), so it only ever runs as a fallback.
ENABLE_OCR=false

# Only needed if the binary is installed somewhere non-standard and off PATH.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Tesseract reads printed characters; it cannot read handwriting, and on a
# handwritten page it returns nonsense rather than failing. When OCR output does
# not read as language, a vision model can transcribe the pages instead.
#
# Off by default for two reasons. It costs money per page against the LiteLLM
# gateway. And what it produces is *model output*, not extracted text - such
# documents are stored with source_type "file-vision-ocr" and should be treated
# as pending human verification, not as source evidence. See
# docs/ocr-and-content-quality.md.
ENABLE_VISION_OCR=false

# A small vision model is the default on purpose: on the page this was built for
# it transcribed more of the working than a larger one. The gateway rejects a
# request whose requested max_tokens exceeds the remaining credit, so the cap is
# always sent explicitly.
VISION_OCR_MODEL=qwen/qwen3-vl-8b-instruct
VISION_OCR_MAX_TOKENS=1500

# Where the Chroma retrieval index persists. Embedding is ~97% of ingest cost -
# about 115s for a 1,598-page textbook - and its rate cannot be tuned, so
# without this the index lives in memory and every restart re-embeds from
# scratch. Measured: re-opening a persisted index takes 0.0s.
#
# Leave unset to keep the index in memory; tests and CI always do.
# The directory is disposable - delete it and re-ingest to rebuild.
CHROMA_DIR=.chroma
